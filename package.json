{
  "name": "skillbox",
  "displayName": "SkillBox",
  "description": "VSCode extension for managing Agent Skills from subscription sources",
  "version": "0.1.12",
  "publisher": "leonezhu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leonezhu/vscode-skillbox.git"
  },
  "bugs": {
    "url": "https://github.com/leonezhu/vscode-skillbox/issues"
  },
  "homepage": "https://github.com/leonezhu/vscode-skillbox#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:skillbox"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skillbox",
          "title": "SkillBox",
          "icon": "resources/skillbox.svg"
        }
      ]
    },
    "views": {
      "skillbox": [
        {
          "id": "skillbox.sources",
          "name": ""
        }
      ]
    },
    "commands": [
      {
        "command": "skillbox.addSource",
        "title": "Add Source",
        "icon": "$(add)"
      },
      {
        "command": "skillbox.refreshSources",
        "title": "Refresh Sources",
        "icon": "$(refresh)"
      },
      {
        "command": "skillbox.syncSource",
        "title": "Sync This Source"
      },
      {
        "command": "skillbox.openSource",
        "title": "Open"
      },
      {
        "command": "skillbox.removeSource",
        "title": "Remove This Source"
      },
      {
        "command": "skillbox.installSkill",
        "title": "Install"
      },
      {
        "command": "skillbox.updateSkill",
        "title": "Update"
      },
      {
        "command": "skillbox.openSettings",
        "title": "Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "skillbox.uninstallSkill",
        "title": "Uninstall"
      },
      {
        "command": "skillbox.openSource",
        "title": "Open"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "skillbox.addSource",
          "when": "view == skillbox.sources",
          "group": "navigation@1"
        },
        {
          "command": "skillbox.refreshSources",
          "when": "view == skillbox.sources",
          "group": "navigation@2"
        },
        {
          "command": "skillbox.openSettings",
          "when": "view == skillbox.sources",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "skillbox.syncSource",
          "when": "view == skillbox.sources && viewItem == source",
          "group": "1_sync"
        },
        {
          "command": "skillbox.openSource",
          "when": "view == skillbox.sources && viewItem == source",
          "group": "2_open"
        },
        {
          "command": "skillbox.removeSource",
          "when": "view == skillbox.sources && viewItem == source",
          "group": "3_manage"
        },
        {
          "command": "skillbox.installSkill",
          "when": "viewItem == skill",
          "group": "1_install"
        },
        {
          "command": "skillbox.updateSkill",
          "when": "viewItem == skill-has-update",
          "group": "1_update"
        },
        {
          "command": "skillbox.uninstallSkill",
          "when": "viewItem == skill-installed || viewItem == skill-has-update",
          "group": "2_uninstall"
        }
      ]
    },
    "configuration": {
      "title": "SkillBox",
      "properties": {
        "skillbox.centralRepo": {
          "type": "string",
          "default": "~/.skillbox",
          "description": "Central repository path for storing synced skills (default: ~/.skillbox)"
        },
        "skillbox.defaultAgent": {
          "type": "string",
          "enum": [
            "github-copilot",
            "opencode",
            "claude-code",
            "cursor",
            "codex",
            "cline",
            "gemini-cli",
            "augment",
            "windsurf",
            "openclaw",
            "roo",
            "continue",
            "goose",
            "firebender",
            "trae",
            "junie",
            "codebuddy",
            "command-code",
            "cortex",
            "kiro-cli",
            "kode",
            "droid",
            "amp",
            "kilo",
            "mcpjam",
            "mistral-vibe",
            "mux",
            "openhands",
            "pi",
            "qoder",
            "qwen-code",
            "deepagents",
            "zencoder",
            "crush",
            "iflow-cli",
            "neovate",
            "pochi",
            "adal",
            "antigravity",
            "trae-cn",
            "kimi-cli",
            "replit",
            "universal"
          ],
          "enumDescriptions": [
            "GitHub Copilot - .agents/skills",
            "OpenCode - .agents/skills",
            "Claude Code - .claude/skills",
            "Cursor - .agents/skills",
            "Codex - .agents/skills",
            "Cline - .agents/skills",
            "Gemini CLI - .agents/skills",
            "Augment - .augment/skills",
            "Windsurf - .windsurf/skills",
            "OpenClaw - skills/",
            "Roo Code - .roo/skills",
            "Continue - .continue/skills",
            "Goose - .goose/skills",
            "Firebender - .agents/skills",
            "Trae - .trae/skills",
            "Junie - .junie/skills",
            "CodeBuddy - .codebuddy/skills",
            "Command Code - .commandcode/skills",
            "Cortex Code - .cortex/skills",
            "Kiro CLI - .kiro/skills",
            "Kode - .kode/skills",
            "Droid - .factory/skills",
            "Amp - .agents/skills",
            "Kilo Code - .kilocode/skills",
            "MCPJam - .mcpjam/skills",
            "Mistral Vibe - .vibe/skills",
            "Mux - .mux/skills",
            "OpenHands - .openhands/skills",
            "Pi - .pi/skills",
            "Qoder - .qoder/skills",
            "Qwen Code - .qwen/skills",
            "Deep Agents - .agents/skills",
            "Zencoder - .zencoder/skills",
            "Crush - .crush/skills",
            "iFlow CLI - .iflow/skills",
            "Neovate - .neovate/skills",
            "Pochi - .pochi/skills",
            "AdaL - .adal/skills",
            "Antigravity - .agents/skills",
            "Trae CN - .trae/skills",
            "Kimi Code CLI - .agents/skills",
            "Replit - .agents/skills",
            "Universal - .agents/skills"
          ],
          "default": "github-copilot",
          "description": "Default agent type for skill installation"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.x",
    "@typescript-eslint/parser": "^7.x",
    "eslint": "^8.x",
    "typescript": "^5.x"
  },
  "dependencies": {
    "simple-git": "^3.x"
  }
}
