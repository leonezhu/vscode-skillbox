{
  "name": "skillbox",
  "displayName": "SkillBox",
  "description": "VSCode extension for managing Agent Skills from subscription sources",
  "version": "0.1.0",
  "publisher": "leonezhu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leonezhu/vscode-skillbox.git"
  },
  "bugs": {
    "url": "https://github.com/leonezhu/vscode-skillbox/issues"
  },
  "homepage": "https://github.com/leonezhu/vscode-skillbox#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:skillbox"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skillbox",
          "title": "SkillBox",
          "icon": "resources/skillbox.svg"
        }
      ]
    },
    "views": {
      "skillbox": [
        {
          "id": "skillbox.sources",
          "name": ""
        }
      ]
    },
    "commands": [
      {
        "command": "skillbox.addSource",
        "title": "Add Source",
        "icon": "$(add)"
      },
      {
        "command": "skillbox.refreshSources",
        "title": "Refresh Sources",
        "icon": "$(refresh)"
      },
      {
        "command": "skillbox.syncSource",
        "title": "Sync This Source"
      },
      {
        "command": "skillbox.openSource",
        "title": "Open"
      },
      {
        "command": "skillbox.removeSource",
        "title": "Remove This Source"
      },
      {
        "command": "skillbox.installSkill",
        "title": "Install"
      },
      {
        "command": "skillbox.updateSkill",
        "title": "Update"
      },
      {
        "command": "skillbox.openSettings",
        "title": "Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "skillbox.uninstallSkill",
        "title": "Uninstall"
      },
      {
        "command": "skillbox.openSource",
        "title": "Open"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "skillbox.addSource",
          "when": "view == skillbox.sources",
          "group": "navigation@1"
        },
        {
          "command": "skillbox.refreshSources",
          "when": "view == skillbox.sources",
          "group": "navigation@2"
        },
        {
          "command": "skillbox.openSettings",
          "when": "view == skillbox.sources",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "skillbox.syncSource",
          "when": "view == skillbox.sources && viewItem == source",
          "group": "1_sync"
        },
        {
          "command": "skillbox.openSource",
          "when": "view == skillbox.sources && viewItem == source",
          "group": "2_open"
        },
        {
          "command": "skillbox.removeSource",
          "when": "view == skillbox.sources && viewItem == source",
          "group": "3_manage"
        },
        {
          "command": "skillbox.installSkill",
          "when": "viewItem == skill",
          "group": "1_install"
        },
        {
          "command": "skillbox.updateSkill",
          "when": "viewItem == skill-has-update",
          "group": "1_update"
        },
        {
          "command": "skillbox.uninstallSkill",
          "when": "viewItem == skill-installed || viewItem == skill-has-update",
          "group": "2_uninstall"
        }
      ]
    },
    "configuration": {
      "title": "SkillBox",
      "properties": {
        "skillbox.centralRepo": {
          "type": "string",
          "default": "~/.skillbox",
          "description": "Central repository path for storing synced skills (default: ~/.skillbox)"
        },
        "skillbox.defaultAgent": {
          "type": "string",
          "enum": ["copilot", "opencode", "claude", "cursor"],
          "enumDescriptions": [
            "GitHub Copilot - skills to .github/skills",
            "OpenCode - skills to .agents/skills",
            "Claude - skills to .claude/skills",
            "Cursor - skills to .cursor/skills"
          ],
          "default": "copilot",
          "description": "Default agent type for skill installation"
        },
        "skillbox.defaultScope": {
          "type": "string",
          "enum": ["project", "global"],
          "enumDescriptions": [
            "Install to current workspace",
            "Install to user home directory"
          ],
          "default": "project",
          "description": "Default installation scope"
        },
        "skillbox.installMethod": {
          "type": "string",
          "enum": ["copy", "symlink"],
          "enumDescriptions": [
            "Copy skill files to target location",
            "Create symbolic link (requires admin privileges on some systems)"
          ],
          "default": "copy",
          "description": "Method for installing skills"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.x",
    "@typescript-eslint/parser": "^7.x",
    "eslint": "^8.x",
    "typescript": "^5.x"
  },
  "dependencies": {
    "simple-git": "^3.x"
  }
}
